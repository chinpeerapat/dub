# Forwards one Railway-generated hostname to the web service while keeping the
# original Host header, so Dub's hostname routing (api/partners/admin/short links)
# works without a custom domain.
{
	auto_https off
	admin off
}

:{$PORT:8080} {
	reverse_proxy {$UPSTREAM:web.railway.internal:3000} {
		# Railway's edge always sets X-Real-IP to the connecting client; never
		# forward client-supplied identity or geo headers.
		header_up X-Real-IP {http.request.header.X-Real-IP}
		header_up X-Forwarded-For {http.request.header.X-Real-IP}
		header_up -X-Geo-*
	}
}
